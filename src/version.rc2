#include <winres.h>
#include "version.h"
// Each consuming .rc defines ASO_FILE_DESCRIPTION, ASO_ORIGINAL_FILENAME and ASO_FILETYPE.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION ASO_VERSION_COMMA
 PRODUCTVERSION ASO_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE ASO_FILETYPE
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Zafer Balkan"
      VALUE "FileDescription", ASO_FILE_DESCRIPTION
      VALUE "FileVersion", ASO_VERSION_STRING
      VALUE "OriginalFilename", ASO_ORIGINAL_FILENAME
      VALUE "LegalCopyright", "(c) 2013 benf.org; modifications copyright (c) 2026 Zafer Balkan"
      VALUE "ProductName", "AlternateStreamOverlay"
      VALUE "ProductVersion", ASO_VERSION_STRING
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
