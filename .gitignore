# Visual C++ (MSBuild) with PowerShell tests
# Keep source, project configuration, scripts, test fixtures and CI files.

# OS-generated metadata
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride
._*
.Trashes/
.fuse_hidden*
.nfs*

# IDE state and caches
.vs/
*.suo
*.user
*.rsuser
*.userosscache
*.sln.docstates
*.VC.db
*.VC.VC.opendb
*.opendb
*.opensdf
*.sdf
*.ncb
*.aps
ipch/
.vshistory/
.history/
.localhistory/

# Visual Studio Code: share selected workspace configuration
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Standard MSBuild configuration/architecture output directories
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
[Dd]ebugPS/
[Rr]eleasePS/
[Ww]in32/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
[Aa][Rr][Mm]64[Ee][Cc]/
[Oo]bj/

# Root-level build staging directories (avoid excluding nested source fixtures)
/build/
/out/
/artifacts/
/.artifacts/

# Compiler, linker and MSBuild intermediates
*.obj
*.pch
*.idb
*.iobj
*.ipch
*.ipdb
*.ilk
*.tlog
*.lastbuildstate
*.recipe
*.pgc
*.pgd
*.sbr
*.bsc
*.res
*.exp
*.intermediate.manifest
*.dll.intermediate.manifest
*.tmp_proj
*.binlog
MSBuild_Logs/
[Bb]uild[Ll]og.*
*.rsp
!Directory.Build.rsp

# Debug-symbol files generated by builds; remove if using committed PDB fixtures
*.pdb

# Unit-test results and coverage output
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml
/coverage/
/PesterResults.xml
/PesterResults.NUnit.xml

# NuGet outputs (package binaries may be intentionally committed elsewhere)
*.nupkg
*.snupkg

# Generated install packages (do not ignore all DLL/EXE files)
*.msi
*.msix
*.msm
*.msp
*.cab

# Optional CMake-generated state, not the CMake project files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
cmake-build-*/

# User-local secrets and environment overrides
.env
.env.*
!.env.example
!.env.sample
*.pfx

# Editor temporary files
*~
~$*
*.swp
*.swo

# Generated stubs
*_i.c
*_i.h
*_p.c