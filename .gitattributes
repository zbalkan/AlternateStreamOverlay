# Automatically detect text files and normalize line endings
* text=auto

# Visual C++ source and headers
*.c    text eol=crlf diff=cpp
*.cc   text eol=crlf diff=cpp
*.cpp  text eol=crlf diff=cpp
*.cxx  text eol=crlf diff=cpp
*.h    text eol=crlf diff=cpp
*.hh   text eol=crlf diff=cpp
*.hpp  text eol=crlf diff=cpp
*.hxx  text eol=crlf diff=cpp
*.rc   text eol=crlf

# PowerShell scripts, modules, manifests, and formatting files
*.ps1    text eol=crlf
*.psm1   text eol=crlf
*.psd1   text eol=crlf
*.ps1xml text eol=crlf

# Visual Studio and MSBuild files
*.sln             text eol=crlf
*.slnx            text eol=crlf
*.vcxproj         text eol=crlf
*.vcxproj.filters text eol=crlf
*.props           text eol=crlf
*.targets         text eol=crlf
*.resx            text eol=crlf

# Windows command scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Repository configuration and documentation
*.sh          text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.json        text eol=lf
*.jsonc       text eol=lf
*.md          text eol=lf diff=markdown
*.markdown    text eol=lf diff=markdown
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore    text eol=lf

# Compiled binaries and intermediate files
*.obj  binary
*.exe  binary
*.lib  binary
*.dll  binary
*.pdb  binary
*.ipdb binary
*.iobj binary
