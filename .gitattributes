# Set default behavior to automatically normalize line endings
* text=auto

# C++ Source Files
*.cpp text diff=cpp
*.h text diff=cpp
*.cc text diff=cpp
*.hpp text diff=cpp
*.c text diff=cpp

# Visual Studio Project and Solution Files
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
*.vcxproj.user text eol=crlf
*.user text eol=crlf

# Compiled Binaries and Intermediate Files
*.obj binary
*.exe binary
*.lib binary
*.dll binary
*.pdb binary
*.ipdb binary
*.iobj binary